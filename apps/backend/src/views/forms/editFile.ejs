
<!DOCTYPE html>
<html lang="en">
    <%- include("../partials/head") %>
    <body class="form-page">
        <%- include("../partials/errors") %>
        <div class="auth-form">
            <form method="post" action="/folder/<%= locals.folderId %>/file/<%= locals.fileId %>/edit">
                <fieldset>
                    <legend>Edit File</legend>
                    <div class="create-file">
                        <label for="fileName">File Name:</label>
                        <input type="text" name="fileName" id="fileName" value="<%= locals.currentName %>">
                    </div>
                    <button type="submit">Submit</button>
                </fieldset>
            </form>
            <%- include('../components/goBackButton') %>
        </div>
    </body>
</html>
