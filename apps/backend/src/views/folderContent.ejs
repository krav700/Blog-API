<!DOCTYPE html>
<html lang="en">
<%- include("partials/head") %>

<body>
    <%- include("partials/heading") %>
    <% if (locals.breadcrumbs) { %>
        <%- include("partials/breadcrumb") %>
    <% } %>
    <%- include("partials/gridLegend") %>
    <div class="content-container">
        <% if (locals.folders) { %>
        <% folders.forEach(folder => { %>
            <%- include("components/folder", { folder: folder }) %>
        <% }) %>
        <% } %>
        <% if (locals.files ) { %>
        <% files.forEach(file => { %>
            <%- include("components/file", { folderId: locals.folderId, file: file }) %>
        <% }) %>
        <% } %>
        <div class="add-component-container">
            <a href="/folder/<%= folderId %>/create">Add Folder</a>
            <a href="/folder/<%= folderId %>/file/create">Add File</a>
        </div>
    </div>
</body>
</html>